#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
YAKUMO_REPO="https://github.com/mikanfactory/yakumo"
YAKUMO_DIR="{{ .chezmoi.homeDir }}/code/yakumo"

if ! command -v swift &> /dev/null; then
    echo "Warning: swift not found, skipping yakumo installation"
    exit 0
fi

if [ ! -d "$YAKUMO_DIR" ]; then
    mkdir -p "$(dirname "$YAKUMO_DIR")"
    if ! git clone "$YAKUMO_REPO" "$YAKUMO_DIR"; then
        echo "Warning: git clone failed, skipping yakumo installation"
        exit 0
    fi
fi

echo "Installing yakumo..."
make -C "$YAKUMO_DIR" install
echo "yakumo installed successfully."
{{ end -}}
