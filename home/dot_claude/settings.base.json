{
  "permissions": {
    "defaultMode": "plan",
    "useAutoModeDuringPlan": true,
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Skill",
      "MultiEdit",
      "WebSearch",
      "WebFetch",
      "mcp__pencil",
      "mcp__mlflow-mcp__*",
      "mcp__plugin_sentry_sentry__*",
      "Bash(mise x -- ls-lint:*)",
      "Bash(hk check:*)",
      "Bash(./scripts/claude/list-aws-roles.sh)",
      "Bash(mise x -- gh pr view:*)",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__list_comments"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(terraform -*)",
      "Bash(terraform init:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform console:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(terraform get:*)",
      "Bash(terraform graph:*)",
      "Bash(terraform import:*)",
      "Bash(terraform login:*)",
      "Bash(terraform logout:*)",
      "Bash(terraform metadata:*)",
      "Bash(terraform modules:*)",
      "Bash(terraform output:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform query:*)",
      "Bash(terraform refresh:*)",
      "Bash(terraform show:*)",
      "Bash(terraform state:*)",
      "Bash(terraform stacks:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform test:*)",
      "Bash(terraform untaint:*)",
      "Bash(terraform version:*)",
      "Bash(terraform workspace:*)",
      "Bash(printenv)"
    ],
    "ask": [
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git rebase)",
      "Bash(git rebase *)"
    ]
  },
  "model": "fable",
  "enabledMcpjsonServers": [],
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "langfuse-observability@langfuse-observability": true,
    "slack@anthropic-plugin-directory": true
  },
  "mcpServers": {},
  "hooks": {},
  "env": {
    "NIPPO_REPORTS_DIR": "reports"
  },
  "agentPushNotifEnabled": true,
  "extraKnownMarketplaces": {
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    }
  },
  "pluginConfigs": {
    "langfuse-observability@langfuse-observability": {
      "options": {
        "LANGFUSE_PUBLIC_KEY": "pk-lf-local",
        "LANGFUSE_BASE_URL": "http://localhost:3000"
      }
    }
  }
}
